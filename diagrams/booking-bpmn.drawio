<mxfile host="app.diagrams.net">
  <diagram name="Booking BPMN" id="booking-bpmn">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="Start" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="selectRoom" value="User selects room" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="170" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="enterDates" value="User enters dates" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="170" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="submitBooking" value="Submit booking request" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="170" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="availability" value="Room available?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="750" y="155" width="110" height="80" as="geometry" />
        </mxCell>
        <mxCell id="unavailable" value="Show room unavailable message" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="730" y="300" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="endUnavailable" value="Booking not created" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="760" y="410" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="paymentDetails" value="User enters payment details" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="170" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="payment" value="Payment successful?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1160" y="155" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="paymentError" value="Show payment error" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1140" y="300" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="cancelPending" value="Cancel pending booking" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1135" y="410" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="endPaymentFailed" value="Booking not confirmed" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="1175" y="520" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="createBooking" value="Create confirmed booking" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1340" y="170" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sendEmail" value="Send confirmation email" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1340" y="280" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="endSuccess" value="Booking confirmed" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="1385" y="390" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="start" target="selectRoom"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="selectRoom" target="enterDates"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="enterDates" target="submitBooking"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="submitBooking" target="availability"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="No" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="availability" target="unavailable"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="unavailable" target="endUnavailable"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="Yes" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="availability" target="paymentDetails"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="paymentDetails" target="payment"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="No" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="payment" target="paymentError"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="paymentError" target="cancelPending"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="cancelPending" target="endPaymentFailed"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="Yes" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="payment" target="createBooking"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="createBooking" target="sendEmail"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="sendEmail" target="endSuccess"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
